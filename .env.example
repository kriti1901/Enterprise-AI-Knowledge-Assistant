# Copy to .env and fill in. Never commit .env.

# --- LLM: "openai" (paid API) or "ollama" (local, free) or "fake" (offline tests) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# For LLM_PROVIDER=ollama (run `ollama pull llama3.2` first; the api container reaches the host via host.docker.internal)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# --- Embeddings ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=google/embeddinggemma-2

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Ingestion and retrieval ---
MAX_UPLOAD_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
CANDIDATE_K=20

# --- Observability (set true on AWS to publish custom metrics to CloudWatch) ---
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NAMESPACE=EnterpriseKnowledgeAssistant
AWS_REGION=us-east-1
